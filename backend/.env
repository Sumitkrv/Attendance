# Flask
FLASK_APP=src/api/app.py
FLASK_ENV=development
APP_ENV=dev
API_RATE_LIMIT_ENABLED=false
PORT=5001
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false
MAX_CONTENT_LENGTH_MB=10
DISABLE_BACKEND_UI=true
FRONTEND_APP_BASE_URL=http://127.0.0.1:5173

# MongoDB — REPLACE with your own credentials
MONGODB_URI=mongodb://localhost:27017/attendance_db
MONGODB_DB=attendance_db
USE_MOCK_DB=true
ALLOW_MOCK_DB=true

# Recognition
MODEL_PATH=../persistent/models/face_encodings.pkl
DATASET_PATH=../persistent/dataset
MANUAL_REQUESTS_IMAGE_DIR=../persistent/manual_requests
ASSETS_DIR=../persistent/assets
ASSETS_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSETS_FOLDER=hrms-employee-assets
CAMERA_INDEX=0
RECOGNITION_TOLERANCE=0.55
FRAME_RESIZE_SCALE=0.25
PROCESS_EVERY_N_FRAMES=2
FACE_DETECTION_MODEL=hog
FACE_UPSAMPLE_TIMES=0

# Liveness / anti-spoofing
ENABLE_LIVENESS=true
SCAN_REQUIRE_BLINK=false
SCAN_REQUIRED_BLINK_COUNT=1
SCAN_MIN_DURATION_SECONDS=0.8
SCAN_FACE_UPSAMPLE_TIMES=0
SCAN_MIN_FACE_AREA_RATIO=0.03
SCAN_EDGE_MARGIN_RATIO=0.02
SCAN_CHALLENGE_TTL_SECONDS=18
LIVENESS_BLINK_CONSEC_FRAMES=2
LIVENESS_MOVEMENT_MIN_PIXELS=3
LIVENESS_MIN_LAPLACIAN_VAR=55

# Fast training
TRAIN_IMAGE_MAX_WIDTH=800
TRAIN_NUM_JITTERS=1
TRAIN_ENCODING_MODEL=small
TRAIN_MAX_WORKERS=0

# Admin dashboard login (change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_EXPIRES_MIN=480
JWT_ADMIN_EXPIRES_MIN=10080
JWT_USER_EXPIRES_MIN=10080

# Office geofence for attendance scanning (set your exact office coordinates)
ENABLE_OFFICE_GEOFENCE=false
FORCE_OFFICE_GEOFENCE=false
OFFICE_LAT=28.6139
OFFICE_LON=77.2090
OFFICE_RADIUS_METERS=100

# Warning email system — REPLACE with your own keys
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_SENDER=hr@yourcompany.com
